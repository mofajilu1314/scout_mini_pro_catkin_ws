<?xml version="1.0" encoding="UTF-8"?>
<!-- Gazebo diff-drive + joint_state plugins (ROS2 Humble / gazebo_plugins) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gazebo_diff_drive" params="
        robot_namespace:=/scout_mini_pro
        left_joint:=rear_left_wheel_joint
        right_joint:=rear_right_wheel_joint
        wheel_separation
        wheel_diameter
        command_topic:=cmd_vel
        odometry_topic:=odom
        odometry_frame:=odom
        robot_base_frame:=base_footprint
        publish_tf:=true
        publish_wheel_joint_state:=true
        update_rate:=50.0
        wheel_torque:=300
        wheel_acceleration:=50.0">
        <gazebo>
            <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
                <ros>
                    <namespace>${robot_namespace}</namespace>
                    <remapping>cmd_vel:=${command_topic}</remapping>
                    <remapping>odom:=${odometry_topic}</remapping>
                </ros>
                <left_joint>${left_joint}</left_joint>
                <right_joint>${right_joint}</right_joint>
                <wheel_separation>${wheel_separation}</wheel_separation>
                <wheel_diameter>${wheel_diameter}</wheel_diameter>
                <max_wheel_torque>${wheel_torque}</max_wheel_torque>
                <max_wheel_acceleration>${wheel_acceleration}</max_wheel_acceleration>
                <publish_odom>true</publish_odom>
                <publish_odom_tf>${publish_tf}</publish_odom_tf>
                <publish_wheel_tf>false</publish_wheel_tf>
                <odometry_frame>${odometry_frame}</odometry_frame>
                <robot_base_frame>${robot_base_frame}</robot_base_frame>
                <update_rate>${update_rate}</update_rate>
            </plugin>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="gazebo_joint_state_publisher" params="
        robot_namespace:=/scout_mini_pro
        update_rate:=50.0">
        <gazebo>
            <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
                <ros>
                    <namespace>${robot_namespace}</namespace>
                    <remapping>joint_states:=joint_states</remapping>
                </ros>
                <update_rate>${update_rate}</update_rate>
                <joint_name>front_left_wheel_joint</joint_name>
                <joint_name>front_right_wheel_joint</joint_name>
                <joint_name>rear_left_wheel_joint</joint_name>
                <joint_name>rear_right_wheel_joint</joint_name>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
