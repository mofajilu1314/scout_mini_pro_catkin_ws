<?xml version="1.0" encoding="UTF-8"?>
<!-- RS-Helios-16P激光雷达：独立文件。用 sensor_fixed_no_gazebo 避免 laser_link 出现两个 gazebo 块，material 由 gazebo_laser_plugin 同块输出，确保 ray_sensor 插件能加载 -->
<robot name="laser_helios" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:sensor_fixed_no_gazebo
        sensor_name="laser_link"
        x="0" y="0" z="0.22"
        joint_name="laser_joint"
        size_x="0.1" size_y="0.1" size_z="0.05"
        mass="0.8"
        color_r="1" color_g="0" color_b="0" color_a="0.5" />
</robot>
