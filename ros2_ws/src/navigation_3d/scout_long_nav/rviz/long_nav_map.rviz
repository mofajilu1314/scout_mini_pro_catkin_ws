Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 16
      Color: 160; 160; 160
      Alpha: 0.35
    - Class: rviz_default_plugins/Map
      Name: CostmapTrav_OFF
      Enabled: false
      Alpha: 0.2
      Draw Behind: true
      Color Scheme: map
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /long_nav/costmap
    - Class: rviz_default_plugins/PointCloud2
      Name: CostmapHeat
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /long_nav/costmap_rgb
      Size (m): 0.12
      Style: Flat Squares
      Color Transformer: RGB8
      Channel Name: rgb
      Use Fixed Frame: true
      Decay Time: 0
      Alpha: 0.95
    - Class: rviz_default_plugins/Image
      Name: CameraRGB
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/Odometry
      Name: OdomNow
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /long_nav/odom
      Keep: 1
      Shape: Arrow
      Color: 0; 255; 0
      Shaft Length: 0.5
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.08
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Axes: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.6
Window Geometry:
  Height: 900
  Width: 1400
