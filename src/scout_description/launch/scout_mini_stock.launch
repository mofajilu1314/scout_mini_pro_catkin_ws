
<launch>
    <arg name="robot_namespace" default="/"/>
    <arg name="urdf_extras" default="$(find scout_description)/urdf/empty.urdf"/>
    <!-- false：仅 skid_steer（gazebo_room_official）；true：加载 gazebo_ros_control（spawn_scout_mini） -->
    <arg name="enable_ros_control" default="false"/>

    <param name="robot_description" command="$(find xacro)/xacro '$(find scout_description)/urdf/mini.xacro'
        robot_namespace:=$(arg robot_namespace)
        urdf_extras:=$(arg urdf_extras)
        enable_ros_control:=$(arg enable_ros_control)" />
</launch>
