<?xml version="1.0"?>
<package format="2">
  <name>scout_offroad_3d</name>
  <version>0.1.0</version>
  <description>
    Off-road perception + stage-A TD3 local policy for Scout Mini.
    range_features → TD3 → /cmd_vel (no Arena/A*/SLAM in stage A).
  </description>
  <maintainer email="todo@todo.todo">scout_offroad</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>scout_mini_pro_description</exec_depend>
</package>
