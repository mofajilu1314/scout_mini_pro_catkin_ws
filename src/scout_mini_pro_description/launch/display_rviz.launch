<?xml version="1.0"?>
<launch>
  <!-- 加载 Scout Mini Pro XACRO 模型 -->
  <param name="robot_description" command="$(find xacro)/xacro $(find scout_mini_pro_description)/xacro/main/scout_mini_pro.xacro" />

  <!-- 关节状态发布器（GUI 版，用于调节车轮等关节） -->
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher">
    <param name="use_gui" value="true" />
  </node>

  <!-- 机器人状态发布器：发布 TF 变换 -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />

  <!-- RVIZ 可视化（预设 RobotModel + TF） -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find scout_mini_pro_description)/rviz/display.rviz" required="false" />
</launch>
