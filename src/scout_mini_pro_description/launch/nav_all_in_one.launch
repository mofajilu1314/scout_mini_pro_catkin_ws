<?xml version="1.0"?>
<!--
  一键室内导航：Gazebo room + map_server + A* + Pure Pursuit + AMCL + RViz。
  用法（先 source 工作空间）：
    source ~/catkin_ws_2/devel/setup.bash
    roslaunch scout_mini_pro_description nav_all_in_one.launch
  Ctrl+C 结束整棵 launch 树。
  注意：spawn 先 wait spawn 服务再短缓冲；AMCL 延迟启动，确保 map_server / 仿真就绪。
-->
<launch>
  <arg name="map_file" default="$(find scout_mini_pro_description)/maps/room.yaml" />
  <arg name="rviz_config" default="$(find scout_mini_pro_description)/rviz/display_room_slam.rviz" />
  <!-- AMCL 延迟：等 Gazebo spawn + map_server 就绪（spawn 已缩短） -->
  <arg name="amcl_delay" default="5" />
  <arg name="rviz_delay" default="3" />

  <!-- 1. Gazebo room（含 use_sim_time=true via empty_world） -->
  <include file="$(find scout_mini_pro_description)/launch/gazebo_room.launch" />

  <!-- 2. 显式保证仿真时间（若上层未设） -->
  <param name="/use_sim_time" value="true" />

  <!-- 3. map_server + A* + Pure Pursuit（与 nav_bringup 一致） -->
  <include file="$(find scout_mini_pro_description)/launch/nav_bringup.launch">
    <arg name="map_file" value="$(arg map_file)" />
  </include>

  <!-- 4. AMCL：加载参数，odom remap 到 /scout_mini_pro/odom，scan=/scan（默认） -->
  <!--    延迟启动，避免 map 尚未发布时 amcl 反复失败 / 段错误 -->
  <rosparam file="$(find scout_mini_pro_description)/config/nav/amcl_params.yaml" command="load" ns="amcl" />
  <node pkg="amcl" type="amcl" name="amcl" output="screen"
        launch-prefix="bash -c 'sleep $(arg amcl_delay); exec $0 $@'"
        required="false">
    <remap from="odom" to="/scout_mini_pro/odom" />
    <remap from="scan" to="/scan" />
  </node>

  <!-- 5. RViz（略延迟，等 TF / 地图） -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        launch-prefix="bash -c 'sleep $(arg rviz_delay); exec $0 $@'"
        required="false"
        output="screen" />
</launch>
