<?xml version="1.0"?>
<!-- 加载 room_1 场景 + Scout Mini Pro 机器人 + RViz 传感器可视化（一键启动） -->
<launch>
  <!-- 1. Gazebo room 仿真（world + 机器人） -->
  <include file="$(find scout_mini_pro_description)/launch/gazebo_room.launch" />

  <!-- 确保 RViz 使用仿真时间，与 Gazebo 消息时间戳一致 -->
  <param name="/use_sim_time" value="true" />

  <!-- 2. RViz：加载 room 专用配置（LaserScan、Camera、PointCloud2、TF） -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find scout_mini_pro_description)/rviz/display_room.rviz" required="false" />
</launch>
