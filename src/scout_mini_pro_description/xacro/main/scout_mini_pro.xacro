<?xml version="1.0" encoding="UTF-8"?>
<!-- Scout Mini Pro主模型：仅整合，无冗余逻辑 -->
<robot name="scout_mini_pro" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- ==================== 1. 全局参数定义（集中管理，一键修改） ==================== -->
    <!-- 车身参数 -->
    <xacro:property name="base_length" value="0.6" />    <!-- 长(m) -->
    <xacro:property name="base_width" value="0.4" />     <!-- 宽(m) -->
    <xacro:property name="base_height" value="0.2" />    <!-- 高(m) -->
    <xacro:property name="base_mass" value="5.0" />      <!-- 质量(kg) -->
    <!-- 车轮参数 -->
    <xacro:property name="wheel_diameter" value="0.15" /> <!-- 直径(m) -->
    <xacro:property name="wheel_width" value="0.08" />   <!-- 宽度(m) -->
    <xacro:property name="wheel_mass" value="0.5" />     <!-- 单轮质量(kg) -->
    <xacro:property name="wheel_x_offset" value="0.25" /> <!-- 车轮前后偏移 -->
    <xacro:property name="wheel_y_offset" value="0.22" /> <!-- 车轮左右偏移 -->
    <xacro:property name="wheel_z_offset" value="${-wheel_diameter/2}" /> <!-- 车轮z轴偏移 -->

    <!-- ==================== 2. 引用子文件（模块化核心） ==================== -->
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/macro/common_macros.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/macro/gazebo_diff_drive.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/macro/gazebo_sensor_plugin.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/actuator/wheel.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/sensor/camera_d435.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/sensor/laser_helios.xacro" />
    <xacro:include filename="$(find scout_mini_pro_description)/xacro/sensor/imu_ch110.xacro" />

    <!-- ==================== 3. base_footprint 虚拟部件（距地 0.01m，作为坐标参考） ==================== -->
    <link name="base_footprint" />

    <!-- ==================== 4. 车身主体（base_link） ==================== -->
    <link name="base_link">
        <!-- 视觉：长方体车身（深灰色） -->
        <visual>
            <origin xyz="0 0 0" />
            <geometry><box size="${base_length} ${base_width} ${base_height}" /></geometry>
            <material name="base_gray"><color rgba="0.3 0.3 0.3 0.5" /></material>
        </visual>
        <!-- 碰撞：与视觉一致 -->
        <collision>
            <origin xyz="0 0 0" />
            <geometry><box size="${base_length} ${base_width} ${base_height}" /></geometry>
        </collision>
        <!-- 惯性：长方体惯性矩 -->
        <inertial>
            <mass value="${base_mass}" />
            <inertia ixx="${(1/12)*base_mass*(base_width**2 + base_height**2)}"
                     ixy="0" ixz="0"
                     iyy="${(1/12)*base_mass*(base_length**2 + base_height**2)}"
                     iyz="0"
                     izz="${(1/12)*base_mass*(base_length**2 + base_width**2)}" />
        </inertial>
        <!-- Gazebo属性：阻尼+材质（简单字符串形式，Gazebo 11 兼容性更好） -->
        <gazebo reference="base_link">
            <material>Gazebo/DarkGrey</material>
            <linear_damping>0.1</linear_damping>
            <angular_damping>0.1</angular_damping>
        </gazebo>
    </link>

    <!-- base_footprint 到 base_link 的固定关节（z=0.01 使车体贴合地面） -->
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.01" rpy="0 0 0" />
    </joint>

    <!-- ==================== 5. 传动宏（Gazebo差速驱动，4轮） ==================== -->
    <xacro:transmission joint_name="front_left_wheel_joint" />
    <xacro:transmission joint_name="front_right_wheel_joint" />
    <xacro:transmission joint_name="rear_left_wheel_joint" />
    <xacro:transmission joint_name="rear_right_wheel_joint" />

    <!-- ==================== 6. Gazebo 差速驱动与关节状态（由宏统一管理参数） ==================== -->
    <xacro:gazebo_diff_drive
        robot_namespace="/scout_mini_pro"
        left_joint="rear_left_wheel_joint"
        right_joint="rear_right_wheel_joint"
        wheel_separation="${2*wheel_y_offset}"
        wheel_diameter="${wheel_diameter}"
        command_topic="cmd_vel"
        odometry_topic="odom"
        odometry_frame="odom"
        robot_base_frame="base_footprint"
        publish_tf="true"
        publish_wheel_joint_state="true"
        update_rate="50.0" />

    <xacro:gazebo_joint_state_publisher
        robot_namespace="/scout_mini_pro"
        joint_names="front_left_wheel_joint, front_right_wheel_joint, rear_left_wheel_joint, rear_right_wheel_joint"
        update_rate="50.0" />

    <!-- ==================== 7. Gazebo 传感器插件（激光雷达、相机、IMU，由 gazebo_sensor_plugin.xacro 统一管理） ==================== -->
    <xacro:gazebo_laser_plugin robot_namespace="/scout_mini_pro" topic="scan" frame_name="laser_link" />
    <xacro:gazebo_camera_plugin robot_namespace="/scout_mini_pro" topic_image="camera/image_raw" topic_info="camera/camera_info" frame_name="camera_link" />
    <xacro:gazebo_imu_plugin robot_namespace="/scout_mini_pro" topic="imu" frame_name="imu_link" />
</robot>
