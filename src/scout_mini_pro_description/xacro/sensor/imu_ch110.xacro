<?xml version="1.0" encoding="UTF-8"?>
<!-- IMU CH110：独立文件 -->
<robot name="imu_ch110" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 调用通用传感器宏：位置+尺寸+颜色（绿色） -->
    <xacro:sensor_fixed 
        sensor_name="imu_link" 
        x="-0.1" y="0" z="0.2"  
        joint_name="imu_joint" 
        size_x="0.05" size_y="0.05" size_z="0.05"
        mass="0.1"
        color_r="0" color_g="1" color_b="0" color_a="0.5" gazebo_material="Gazebo/Green" />     <!-- CH110 约0.1kg -->
</robot>
