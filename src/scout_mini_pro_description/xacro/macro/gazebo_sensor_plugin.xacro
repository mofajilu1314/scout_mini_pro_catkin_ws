<?xml version="1.0" encoding="UTF-8"?>
<!-- Gazebo 传感器插件宏：激光雷达、相机、IMU 的话题与参数集中管理，便于调整 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- ==================== 激光雷达插件（LaserScan） ==================== -->
    <xacro:macro name="gazebo_laser_plugin" params="
        robot_namespace:=/scout_mini_pro
        link_ref:=laser_link
        topic:=scan
        frame_name:=laser_link
        update_rate:=10.0
        samples:=360
        angle_min:=-${M_PI}
        angle_max:=${M_PI}
        range_min:=0.1
        range_max:=10.0">
        <gazebo reference="${link_ref}">
            <sensor name="laserscan" type="ray">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <visualize>true</visualize>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>${samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>${angle_min}</min_angle>
                            <max_angle>${angle_max}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${range_min}</min>
                        <max>${range_max}</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>${robot_namespace}</namespace>
                        <remapping>~/out:=${topic}</remapping>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>${frame_name}</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- ==================== 相机插件（Image + CameraInfo） ==================== -->
    <xacro:macro name="gazebo_camera_plugin" params="
        robot_namespace:=/scout_mini_pro
        link_ref:=camera_link
        topic_image:=camera/image_raw
        topic_info:=camera/camera_info
        frame_name:=camera_link
        update_rate:=30.0
        width:=640
        height:=480
        hfov:=1.0472">
        <gazebo reference="${link_ref}">
            <sensor name="camera" type="camera">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <visualize>true</visualize>
                <camera>
                    <horizontal_fov>${hfov}</horizontal_fov>
                    <image>
                        <width>${width}</width>
                        <height>${height}</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.02</near>
                        <far>300</far>
                    </clip>
                </camera>
                <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>${robot_namespace}</namespace>
                        <remapping>image_raw:=${topic_image}</remapping>
                        <remapping>camera_info:=${topic_info}</remapping>
                    </ros>
                    <camera_name>camera</camera_name>
                    <frame_name>${frame_name}</frame_name>
                    <hack_baseline>0.07</hack_baseline>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- ==================== IMU 插件（Imu） ==================== -->
    <xacro:macro name="gazebo_imu_plugin" params="
        robot_namespace:=/scout_mini_pro
        link_ref:=imu_link
        topic:=imu
        frame_name:=imu_link
        update_rate:=100.0
        gaussian_noise:=0.0">
        <gazebo reference="${link_ref}">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <visualize>true</visualize>
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </x>
                        <y>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </y>
                        <z>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </x>
                        <y>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </y>
                        <z>
                            <noise type="gaussian" mean="0.0" stddev="${gaussian_noise}" bias_mean="0.0" bias_stddev="0.0" />
                        </z>
                    </linear_acceleration>
                </imu>
                <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <namespace>${robot_namespace}</namespace>
                        <remapping>~/out:=${topic}</remapping>
                    </ros>
                    <frame_name>${frame_name}</frame_name>
                    <initial_orientation_as_reference>false</initial_orientation_as_reference>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
